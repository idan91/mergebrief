{
  "name": "logging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The structured-logging boundary: a minimal Logger interface + createLogger over pino. Call sites depend on this package only — pino types never leak; a later OTel/metrics addition reimplements the interface without touching call sites.",
  "license": "FSL-1.1-ALv2",
  "exports": {
    ".": "./src/index.ts",
    "./sanitize": "./src/sanitize.ts",
    "./tracing": "./src/tracing/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "import-in-the-middle": "^3.5.2",
    "pino": "^10.1.0",
    "types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
