{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The long-lived background worker (BRIEF-3, ADR 0015): drains graphile-worker's `generate` jobs and runs brief/delta generation off the human path.",
  "exports": {
    ".": "./src/lib.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "brief-core": "workspace:*",
    "generators": "workspace:*",
    "github": "workspace:^",
    "graphile-worker": "^0.16.6",
    "persistence": "workspace:*",
    "repo-config": "workspace:*",
    "types": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
