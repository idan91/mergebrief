exports[`wire json schemas are byte-pinned > delta 1`] = `
"{
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "bugfix",
        "logic-refactor",
        "move-with-edits",
        "lib-bump",
        "pure-move",
        "new-feature",
        "dependency-update",
        "schema-change"
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "description": "first line number (1-based, inclusive)\\n\\n{minimum: -9007199254740991, maximum: 9007199254740991}"
        },
        "end": {
          "type": "integer",
          "description": "last line number (inclusive); equals start for a single line\\n\\n{minimum: -9007199254740991, maximum: 9007199254740991}"
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "no-tests",
        "no-types",
        "legacy-area",
        "dense-logic",
        "touches-auth",
        "mutates-state",
        "removes-validation",
        "relaxes-permissions",
        "widens-error-handling",
        "adds-feature-flag",
        "new-dependency",
        "new-abstraction",
        "comment-contradicts-code",
        "external-io",
        "cross-service",
        "schema-adjacent",
        "hot-path",
        "widely-imported",
        "release-imminent"
      ]
    }
  },
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Markdown reload, deliberately short: a lede of 1-3 short sentences on what changed *since the baseline* (plain text, no headings), then optionally a '## Changelog' of 1-3 bullets covering the follow-up commits. Hard caps, never targets. Frame it as 'since you last looked'."
    },
    "commentsAddressed": {
      "type": "string",
      "description": "Markdown: how the follow-up answers the prior review comments overall. Empty string when there are no comments. Never author replies — only describe how the change addresses them."
    },
    "changedGroups": {
      "type": "array",
      "description": "change-groups for the incremental (baseline→head) change only",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "stable group id referenced by chunks' changeGroupId, e.g. g1, g2, …"
          },
          "title": {
            "type": "string",
            "description": "a one-line title describing the change group (what, not why), ideally under ~100 characters (~150 ceiling), e.g. 'Add stock-location module to inventory service'"
          },
          "summary": {
            "type": "string",
            "description": "what the group does (what, not why), one group = one summary: 1-2 short sentences, ~200 characters ideal (~250 ceiling, never a target)"
          },
          "dominantCategory": {
            "$ref": "#/$defs/__schema0"
          },
          "secondaryCategories": {
            "type": "array",
            "description": "additional intents present in the group (empty if none)",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "uncertain": {
            "type": "boolean",
            "description": "true when confidence on the dominant category is below threshold. AI never hides uncertainty — flag it rather than forcing a token."
          },
          "uncertainBetween": {
            "type": "array",
            "description": "the categories in tension when uncertain=true (e.g. new-feature vs bugfix); empty when uncertain=false",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "dominantCategory",
          "secondaryCategories",
          "uncertain",
          "uncertainBetween"
        ]
      }
    },
    "chunks": {
      "type": "array",
      "description": "chunks of the incremental change only",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "stable chunk id, e.g. c1, c2, …"
          },
          "changeGroupId": {
            "type": "string",
            "description": "id of the single change-group this chunk belongs to (exactly one — a chunk is never shared across groups; a file spans groups only via different chunks)"
          },
          "file": {
            "type": "string",
            "description": "file path the chunk lives in"
          },
          "concern": {
            "type": "string",
            "description": "artifact kind; mostly derivable from the file path",
            "enum": [
              "implementation",
              "test",
              "doc",
              "spec",
              "config",
              "generated"
            ]
          },
          "role": {
            "type": "string",
            "description": "core holds the group's intent — never 'most important' or largest; supporting serves it. Default from concern (implementation→core, else supporting); flip when a supporting artifact is itself the purpose (e.g. flaky-test fix). Type, context, and CSS/style files are core when they define the changed contract, state model, or visual behavior; supporting only when they merely accompany another core chunk.",
            "enum": [
              "core",
              "supporting"
            ]
          },
          "addedRanges": {
            "type": "array",
            "description": "new-side (+) line-number ranges of the actual ADDED lines in this chunk — changed lines only, NOT the @@ hunk window. Empty if the chunk only deletes. Many disjoint ranges = scattered change.",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "removedRanges": {
            "type": "array",
            "description": "old-side (−) line-number ranges of the actual REMOVED lines in this chunk — changed lines only, NOT the @@ hunk window. Empty if the chunk only adds.",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "riskSurface": {
            "type": "array",
            "description": "factual attributes that apply to this chunk (empty if none). Never verdicts — severity emerges from combinations.",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "riskNotes": {
            "type": "array",
            "description": "optional short factual notes, one per risk-surface attribute on this chunk that needs evidence. REQUIRED for \`comment-contradicts-code\`: the note must cite both sides — the comment line and the code line, e.g. \\"comment says X (L12), code does Y (L15)\\". Omit entirely when no attribute needs a note.",
            "items": {
              "type": "object",
              "properties": {
                "attr": {
                  "$ref": "#/$defs/__schema2"
                },
                "note": {
                  "type": "string",
                  "description": "one short factual note. For \`comment-contradicts-code\` it MUST cite both sides: the comment line and the code line, e.g. \\"comment says X (L12), code does Y (L15)\\"."
                }
              },
              "additionalProperties": false,
              "required": [
                "attr",
                "note"
              ]
            }
          },
          "summary": {
            "type": "string",
            "description": "one-line, what changed in this chunk (what, not why)"
          },
          "addressesComments": {
            "type": "array",
            "description": "ids of the review comments this chunk resolves (empty if it addresses none)",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "changeGroupId",
          "file",
          "concern",
          "role",
          "addedRanges",
          "removedRanges",
          "riskSurface",
          "summary",
          "addressesComments"
        ]
      }
    },
    "wholePrImpact": {
      "type": "string",
      "description": "how this follow-up affects the overall PR — does it complete/alter the original intent, or introduce new risk not present at the baseline. Grounded in the diff; not a verdict."
    }
  },
  "additionalProperties": false,
  "required": [
    "summary",
    "commentsAddressed",
    "changedGroups",
    "chunks",
    "wholePrImpact"
  ],
  "description": "{$schema: \\"https://json-schema.org/draft/2020-12/schema\\"}"
}"
`;

