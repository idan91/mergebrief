{
  "name": "brief-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Brief domain core: schema, taxonomy prompt, categorize engine, repo-context, delta/comparison logic. The dev CLIs and the eval harness live in tools/categorizer and consume this package.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./artifact": "./src/artifact/index.ts",
    "./remap": "./src/diff/remap.ts",
    "./cli-config": "./src/cli/config.ts",
    "./path-matching": "./src/path-matching.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "generators": "workspace:*",
    "i18n": "workspace:*",
    "types": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
