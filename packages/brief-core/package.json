{
  "name": "brief-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Brief domain core: schema, taxonomy prompt, categorize engine, repo-context, delta/comparison logic. The dev CLIs and the eval harness live in tools/categorizer and consume this package.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./artifact": "./src/artifact/index.ts",
    "./pr-stack": "./src/pr-stack/index.ts",
    "./pr-url": "./src/github/pr-url.ts",
    "./gh-exec": "./src/github/exec.ts",
    "./remap": "./src/diff/remap.ts",
    "./chunk-layout": "./src/diff/chunk-layout/index.ts",
    "./pr-span": "./src/diff/pr-span/index.ts",
    "./path-matching": "./src/path-matching.ts",
    "./hidden-chars": "./src/hidden-chars.ts",
    "./media": "./src/media/index.ts",
    "./media-address": "./src/media-address/index.ts",
    "./sanitized-markdown": "./src/sanitized-markdown/index.ts",
    "./shortened": "./src/generation/shortened/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "contract": "workspace:*",
    "diff": "9.0.0",
    "generators": "workspace:*",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "types": "workspace:*",
    "unified": "11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
