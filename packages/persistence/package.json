    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
