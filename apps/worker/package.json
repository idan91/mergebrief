{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The long-lived background worker: drains graphile-worker's `generate` jobs and runs brief/delta generation off the human path.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "brief-core": "workspace:*",
    "generators": "workspace:*",
    "github": "workspace:^",
    "graphile-worker": "^0.16.6",
    "logging": "workspace:*",
    "persistence": "workspace:*",
    "repo-config": "workspace:*",
    "tsx": "^4.19.0",
    "types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
