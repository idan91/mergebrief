{
  "name": "@code-review/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:demo": "tsx scripts/build-demo.ts",
    "lint": "stylelint \"src/**/*.{css,scss}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "perf:fixture": "tsx e2e/perf/generateFixture.ts",
    "perf:measure": "MERGEBRIEF_E2E_PORT=3313 MERGEBRIEF_E2E_REPO_ID=424243 MERGEBRIEF_E2E_REPO_SLUG=mergebrief/perf-fixture MERGEBRIEF_E2E_FIXTURE_DIR=e2e/perf/generated playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-virtual": "^3.14.9",
    "brief-core": "workspace:*",
    "clsx": "2.1.1",
    "contract": "workspace:*",
    "i18n": "workspace:*",
    "i18next": "^26.3.6",
    "logging": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.2.4",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "repo-config": "workspace:*",
    "sass": "^1.89.0",
    "shiki": "4.4.3",
    "srvx": "^0.11.16",
    "tsx": "^4.19.0",
    "types": "workspace:*",
    "unist-util-visit": "5.1.0",
    "zod": "^4.6.5",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/hast": "3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.8",
    "ingest-briefs": "workspace:*",
    "jsdom": "29.1.1",
    "persistence": "workspace:*",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.7.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.0.14",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.1.8"
  }
}
