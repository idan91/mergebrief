# `pnpm dev` and running the API directly: copy to apps/api/.env and fill in.
# Never commit real values. Compose and `pnpm app:host` use the root `.env`.
#
# The API validates every variable at boot; an invalid one stops the process.
# This is the tier that holds credentials: the web tier holds none. This file
# lists what a dev run usually sets. Every variable:
# docs/self-host/configuration.md

# Matches docker-compose.yml's loopback Postgres. A non-loopback host boots
# only on `?sslmode=verify-full` (add `&sslrootcert=/path/ca.pem` for a private
# CA) or `?sslmode=disable`.
# DATABASE_URL_FILE=<path> reads the DSN from a file instead (wins over
# DATABASE_URL, with a boot warning).
# MERGEBRIEF_AUTO_MIGRATE=false makes boot a check-only migration comparison,
# for runtime roles without DDL.
DATABASE_URL=postgres://code_review:code_review@127.0.0.1:5432/code_review

# GitHub App, dev registration (docs/self-host/github-app.md).
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two: a path to the .pem, OR the inline PEM contents.
GITHUB_APP_PRIVATE_KEY_PATH=<path-to-your-app-private-key.pem>
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<...>\n-----END RSA PRIVATE KEY-----"
# HMAC secret verifying inbound deliveries; must equal the App's Webhook secret.
# openssl rand -hex 32 (boot refuses under 32 characters)
GITHUB_WEBHOOK_SECRET=<your-webhook-secret>
# The App's OAuth client, for reviewer sign-in.
GITHUB_OAUTH_CLIENT_ID=<your-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<your-oauth-client-secret>
# Optional: the App's URL name (github.com/apps/<slug>). Set, Home links a
# viewer with no reachable installation to its install page.
# GITHUB_APP_SLUG=<your-app-slug>

# Public origin (scheme + host, no trailing slash) the OAuth callback URL is
# built from. Must match the App's registered callback host and the web tier's
# PUBLIC_BASE_URL. In dev with a tunnel this is your ngrok URL. A signed-in
# browser's state-changing request from any other origin is refused, so browse
# the app at exactly this origin.
PUBLIC_BASE_URL=http://localhost:3000

# AES-256 key (base64 of 32 bytes) sealing reviewer session tokens at rest.
# Generate with: openssl rand -base64 32
# Changing it makes every stored token undecryptable, which reads as a mass
# logout; boot resolves it eagerly so that failure is loud.
SESSION_KEY_V1=<your-base64-32-byte-key>
# The env var NAME new tokens seal under; set it to a new key var to rotate.
# SESSION_KEY_REF=SESSION_KEY_V1

# An instance starts closed: nobody signs in until this config lists them under
# `operators`. Copy mergebrief.config.example.yaml to mergebrief.config.yaml.
# A relative path resolves against the checkout root.
# MERGEBRIEF_CONFIG=mergebrief.config.yaml

# Where the API listens. Compose overrides the host to 0.0.0.0, reachable only
# on the project network.
# MERGEBRIEF_API_HOST=127.0.0.1
# MERGEBRIEF_API_PORT=3001

# What one reviewer may attach per window, counted in memory per api process.
# Positive whole numbers, and the megabytes at least 10, the size limit of one
# file; anything else refuses boot.
# MERGEBRIEF_ATTACHMENT_QUOTA_FILES=10
# MERGEBRIEF_ATTACHMENT_QUOTA_MB=30
# MERGEBRIEF_ATTACHMENT_QUOTA_WINDOW_MINUTES=10

# The largest video or image, in megabytes, a media read streams; a larger one
# answers 413. Positive whole number; anything else refuses boot.
# MERGEBRIEF_MEDIA_MAX_MB=100

# error | warn | info | debug. Default: info.
# LOG_LEVEL=info

# Tracing to an OTLP/HTTP endpoint, off when unset (`pnpm start` loads the
# preload). The root .env.example lists the other OTEL_* knobs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Reported by /api/version. Set it to whatever identifies the build.
# SERVER_VERSION=dev

# URL fallback token: reads a pasted private PR the App is not installed
# on, after the reviewer's own token is denied. It serves only the GitHub
# account that owns it.
# MERGEBRIEF_URL_FALLBACK_TOKEN=<token>

# DEV ONLY. Point this at a directory of generated brief artifacts and Home
# lists them, `/briefs/<id>` renders one: no database, no worker. The image
# and NODE_ENV=production never serve them whatever this is set to; a dev run
# serves them only to a signed-in session.
# Generate artifacts into it with:
#   pnpm -C apps/web perf:fixture -- --out <dir>        (synthetic, free)
#   pnpm -C tools/categorizer categorize --out <dir> <pr-url>   (real, costs)
# Absolute, or relative to the checkout root (NOT to apps/api, the API's
# working directory). Unset, Home lists rows alone.
# MERGEBRIEF_OUT_DIR=tools/categorizer/out
