# Copy this file to .env and fill in the values. NEVER commit real secrets.
#
# The API composition root (src/main.ts) loads `apps/api/.env` and validates
# every block below before it listens; an invalid var stops the process rather
# than serving a half-configured API. This is the tier that holds credentials:
# the web tier holds none.
#
# For `docker compose`, the repo-root `.env` is the file to fill in instead.
# This one is for running the API directly, which is what `pnpm dev` does.

# Postgres connection URL — matches docker-compose.yml's loopback Postgres.
# A NON-loopback host requires an explicit sslmode:
# `?sslmode=verify-full&sslrootcert=/path/ca.pem`, `?sslmode=require`, or
# `?sslmode=disable` — boot refuses otherwise. DATABASE_URL_FILE=<path> reads
# the DSN from a file instead (wins over DATABASE_URL, with a boot warning);
# MERGEBRIEF_AUTO_MIGRATE=false switches boot to a check-only migration
# comparison for DDL-less runtime roles.
DATABASE_URL=postgres://code_review:code_review@127.0.0.1:5432/code_review

# GitHub App (dev registration — see docs/self-host/github-app.md).
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two: a path to the .pem, OR the inline PEM contents.
GITHUB_APP_PRIVATE_KEY_PATH=<path-to-your-app-private-key.pem>
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<...>\n-----END RSA PRIVATE KEY-----"
# HMAC secret verifying inbound deliveries — must equal the App's Webhook secret
# (generate with: openssl rand -hex 32).
GITHUB_WEBHOOK_SECRET=<your-webhook-secret>
# OAuth App credentials for reviewer login.
GITHUB_OAUTH_CLIENT_ID=<your-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<your-oauth-client-secret>
# Optional: the App's URL name (github.com/apps/<slug>). Set, Home links a
# viewer with no reachable installation to its install page.
# GITHUB_APP_SLUG=<your-app-slug>

# Public origin (scheme + host, no trailing slash) the OAuth callback URL is
# built from — must match the App's registered callback host, and the web
# tier's PUBLIC_BASE_URL. In dev with a tunnel this is your ngrok URL.
PUBLIC_BASE_URL=http://localhost:3000

# AES-256 key (base64-encoded 32 bytes) that reviewer session tokens are
# encrypted at rest under. Generate with: openssl rand -base64 32
# Changing it makes every stored token undecryptable, which reads as a mass
# logout; boot resolves it eagerly so that failure is loud.
SESSION_KEY_V1=<your-base64-32-byte-key>

# Where the API listens. Defaults below; the compose service overrides the host
# to 0.0.0.0 because it is reachable only on the project network.
# MERGEBRIEF_API_HOST=127.0.0.1
# MERGEBRIEF_API_PORT=3001

# error | warn | info | debug. Default: info.
# LOG_LEVEL=info

# Reported by /api/version. Set it to whatever identifies the build.
# SERVER_VERSION=dev

# Fallback token for the screenshot service, when one is configured.
# MERGEBRIEF_URL_BOX_TOKEN=<token>
