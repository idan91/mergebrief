{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Hono HTTP surface: webhook ingest, OAuth, and read/write routes. Composes github (primitives) with persistence (tenant-scoped writes).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "manifest": "tsx scripts/generate-manifest.ts",
    "manifest:check": "tsx scripts/generate-manifest.ts --check"
  },
  "dependencies": {
    "brief-core": "workspace:*",
    "github": "workspace:*",
    "graphile-worker": "^0.16.6",
    "hono": "^4.9.10",
    "logging": "workspace:*",
    "persistence": "workspace:*",
    "types": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@octokit/webhooks-methods": "^5.1.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "i18n": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
