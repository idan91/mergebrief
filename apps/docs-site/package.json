{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MergeBrief documentation site: the public docs/ pages built with VitePress.",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": "^24 || >=26"
  },
  "scripts": {
    "dev": "node --import tsx ./node_modules/vitepress/bin/vitepress.js dev",
    "build": "node --import tsx ./node_modules/vitepress/bin/vitepress.js build",
    "preview": "node --import tsx ./node_modules/vitepress/bin/vitepress.js preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "github-slugger": "^2.0.0",
    "i18n": "workspace:*",
    "node-html-parser": "^9.0.6",
    "tsx": "^4.19.0",
    "types": "workspace:*",
    "typescript": "^5.7.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.8"
  }
}
