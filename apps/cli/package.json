{
  "name": "mergebrief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MergeBrief CLI — humans and AI agents over the read/write API.",
  "bin": {
    "mergebrief": "./dist/mergebrief.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsup",
    "link-dev": "pnpm build && pnpm link --global",
    "docs:appendix": "tsx scripts/embed-help.ts",
    "docs:check": "tsx scripts/embed-help.ts --check",
    "map:check": "tsx scripts/check-operations-map.ts"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "i18n": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "persistence": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "types": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
