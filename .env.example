# Self-host configuration — copy to `.env` (gitignored) and fill in.
# docker-compose reads this file for BOTH services; leave a var out entirely
# (rather than setting it empty) when it does not apply — several loaders
# distinguish unset from empty (e.g. the App private-key one-of below).

# --- Postgres (the single stateful dependency) -------------------------------
# Compose interpolates these into the postgres service AND derives both
# services' in-network DATABASE_URL from them. Defaults (code_review /
# code_review / code_review) keep `docker compose up` working out of the box
# — CHANGE THE PASSWORD BEFORE THE FIRST BOOT of anything reachable beyond
# your machine. Postgres writes the role during first-time initialization
# ONLY: after that, changing this value needs an `ALTER ROLE ... PASSWORD`
# inside the container (or deleting the `postgres_data` volume, which
# destroys your data). The value is interpolated RAW into a connection
# string, so keep it to characters that need no escaping — hex is always
# safe. Do NOT percent-encode: postgres stores the role password exactly as
# given here, while the connection string is DECODED on the way in, so an
# encoded password authenticates as something else and the first boot fails.
#   openssl rand -hex 24
# POSTGRES_USER=code_review
# POSTGRES_PASSWORD=<generate-one>
# POSTGRES_DB=code_review

# --- External Postgres (BRIEF-131; skip with the bundled compose postgres) ---
# Point both services at a managed/external database instead of the compose
# one (docker-compose.external-db.yml — see docs/self-host/compose.md). A
# NON-LOOPBACK host requires an explicit sslmode in the DSN or boot is
# refused: verify-full + sslrootcert (recommended), require, or disable
# (private networks only). Note pg's trap: today `require` verifies like
# verify-full, but pg v9 adopts libpq semantics where it does NOT — write
# what you mean.
# DATABASE_URL=postgres://app:<password>@db.provider.example:5432/mergebrief?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem
# Or read the DSN from a file (compose `secrets:` mount) — wins over
# DATABASE_URL with a boot warning; surrounding whitespace is trimmed:
# DATABASE_URL_FILE=/run/secrets/database-url
# Restricted runtime role without DDL? false = check-only at boot: refuse
# when migrations are pending instead of applying them (run
# `pnpm -C packages/persistence migrate` with a DDL-capable DATABASE_URL).
# MERGEBRIEF_AUTO_MIGRATE=true

# --- GitHub App (web webhook/auth tier AND worker PR fetches) ---------------
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two. For compose, the inline PEM is simplest
# (multi-line values work in compose env_file when quoted; or mount a file
# and use the _PATH variant).
GITHUB_APP_PRIVATE_KEY=<pem-contents>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=<webhook-secret>
GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>

# --- Reviewer sessions (web + worker) -------------------------------------------------
# 32-byte base64 key sealing reviewer OAuth tokens (ADR 0018 D11), e.g.:
#   openssl rand -base64 32
SESSION_KEY_V1=<base64-32-bytes>

# --- Public origin (web + worker) ---------------------------------------------
# Must match the GitHub App's registered OAuth callback origin. The worker
# also requires it: the Entry comment's deep link is built from this origin.
PUBLIC_BASE_URL=http://localhost:3000

# Feature flags. Everything matching ENABLE_* is inlined into the client
# bundle, so only boolean toggles belong under this prefix, never a secret.
# Language selection is off by default: the catalog and locale machinery stay
# wired, the picker is simply not rendered.
ENABLE_LANGUAGE_SELECTION=false

# --- Generation provider key (worker + web; BYOK by env-name, ADR 0013) -----
# The zero-config default reads ANTHROPIC_API_KEY. A different provider or
# key variable is selected in mergebrief.config.yaml (copy
# mergebrief.config.example.yaml; see docs/self-host/generators.md); point
# MERGEBRIEF_CONFIG at that file. GENERATOR_API_KEY_ENV was removed in
# BRIEF-11 — setting it refuses boot with a migration hint.
ANTHROPIC_API_KEY=<your-anthropic-key>
# Other providers' key vars (only the one your config names is required):
# OPENROUTER_API_KEY=<your-openrouter-key>
# OPENAI_API_KEY=<your-openai-key>
# cursor only, OPTIONAL — the interactive `cursor-agent login` is the normal
# route; this env key outranks it and bills the same subscription pool.
# On macOS the CLI persists it to the keychain.
# CURSOR_API_KEY=<your-cursor-key>

# --- URL-box fallback token (worker + web; optional) -----------------------
# GitHub App sign-in tokens are INSTALLATION-SCOPED: the "Turn a PR into a
# brief" box cannot read a private repo the App is not installed on, even for
# the repo's owner. Public repos need no PAT — a sign-in token reads those.
# A PAT here (fine-grained, Contents+Pull requests read on the repos you
# want) backstops exactly that private case — tried only after the viewer's
# token is denied, by the paste door, the worker, AND the read gate that
# opens the resulting brief. CAVEAT: every signed-in viewer of this instance
# can then generate and read briefs for anything this token reads.
# Single-operator instances only.
# MERGEBRIEF_URL_BOX_TOKEN=<your-fine-grained-pat>

# Relative = resolved against the workspace root (BRIEF-70) — the same
# value works locally and in the dockerized services. Absolute paths work
# too. For live edits without an image rebuild, also uncomment the
# mergebrief.config.yaml mount in docker-compose.yml.
# MERGEBRIEF_CONFIG=mergebrief.config.yaml

# --- Audit retention (worker; optional) -------------------------------------
# Unset keeps audit rows forever, which is the default posture. Set a number
# of days and the worker's daily sweep erases anything older, across every
# installation. Minimum 30 — and set it longer than your longest open PR:
# audit has to outlive a review session. See docs/self-host/operations.md.
# AUDIT_RETENTION_DAYS=365
