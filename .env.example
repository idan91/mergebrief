# MergeBrief settings: copy to `.env` beside docker-compose.yml and fill in.
# `.env` is gitignored. Never commit real values.
#
# Uncommented lines are required. A commented line is optional and shows the
# default, or an example where the variable has no default.
# Leave out a variable that does not apply. Do not set it empty: some loaders
# read empty differently from unset. A bad value refuses boot.
#
# Each heading names the processes that use the block. Compose loads this file
# into `api` and `worker` and uses it for ${...} interpolation. `web` holds no
# credentials and gets no env_file: compose sets what it reads.
#
# Every variable, its accepted values and what empty does:
# docs/self-host/configuration.md

# =============================================================================
# REQUIRED
# =============================================================================

# --- GitHub App (api, worker) ------------------------------------------------
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two. Inline is simplest under compose (quote a
# multi-line value); the path form needs the file mounted.
GITHUB_APP_PRIVATE_KEY=<pem-contents>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# openssl rand -hex 32 (boot refuses under 32 characters)
GITHUB_WEBHOOK_SECRET=<webhook-secret>
# The App's OAuth client: the api's sign-in, and the worker revoking a swept
# grant's token at GitHub.
GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>

# --- Reviewer sessions (api, worker) -----------------------------------------
# Base64 of 32 bytes, sealing reviewer OAuth tokens at rest. The worker opens
# grants with it for pasted PRs and the hourly sweep.
#   openssl rand -base64 32
SESSION_KEY_V1=<base64-32-bytes>

# --- Public origin (api, web, worker) ----------------------------------------
# The origin reviewers browse, scheme and port included. It must match the
# GitHub App's OAuth callback origin. The worker builds the Entry comment's
# link from it, and the api refuses a signed-in browser's state-changing
# request from any other origin.
PUBLIC_BASE_URL=http://localhost:3000

# --- Generation provider key (worker) ----------------------------------------
# The zero-config provider reads ANTHROPIC_API_KEY. Another provider or key
# variable is selected in mergebrief.config.yaml (docs/self-host/generators.md);
# only the variable that config names is required.
ANTHROPIC_API_KEY=<your-anthropic-key>
# OPENAI_API_KEY=<your-openai-key>
# OPENROUTER_API_KEY=<your-openrouter-key>
# Host processes only (`pnpm app:host`): the image refuses every CLI provider,
# so this does nothing under compose. `cursor-agent login` is the normal route;
# this key outranks it and bills the same subscription pool. On macOS the CLI
# persists it to the keychain.
# CURSOR_API_KEY=<your-cursor-key>

# =============================================================================
# NEEDED BEFORE ANYONE CAN SIGN IN
# =============================================================================

# --- Instance config (api, worker) -------------------------------------------
# An instance starts closed: nobody signs in until mergebrief.config.yaml lists
# them under `operators` (copy mergebrief.config.example.yaml). A relative path
# resolves against the workspace root, here and in the image. The image carries
# no config file: mount it into api and worker from docker-compose.override.yml,
# or both refuse to boot on the missing file. See docs/self-host/compose.md.
# MERGEBRIEF_CONFIG=mergebrief.config.yaml

# =============================================================================
# DATABASE (pick one: bundled, host processes or external)
# =============================================================================

# --- Bundled Postgres (compose) ----------------------------------------------
# Compose creates the role from these and derives the in-network DATABASE_URL
# for api and worker. Default: code_review for all three.
# SET THE PASSWORD BEFORE THE FIRST BOOT of anything reachable beyond your
# machine. Postgres writes the role on first init only; changing it later takes
# an `ALTER ROLE ... PASSWORD` in the container, or deleting the `postgres_data`
# volume, which destroys your data.
# Use `openssl rand -hex 24` verbatim. The value lands raw in a connection
# string that is decoded on the way in, so a percent-encoded password or one
# holding URL syntax authenticates as something else and first boot fails.
# POSTGRES_USER=code_review
# POSTGRES_PASSWORD=<generate-one>
# POSTGRES_DB=code_review

# --- Host processes (`pnpm app:host`) ----------------------------------------
# Required on the host, where nothing derives it. The default compose file
# overrides this value for its own containers.
# DATABASE_URL=postgres://code_review:code_review@127.0.0.1:5432/code_review

# --- External Postgres (api, worker, migrate) --------------------------------
# Names the compose file without the bundled postgres, for every plain
# `docker compose` command. It turns off the automatic override file: once you
# have one, append it, docker-compose.external-db.yml:docker-compose.override.yml
# COMPOSE_FILE=docker-compose.external-db.yml
# A non-loopback host boots only on sslmode=verify-full (add sslrootcert for a
# private CA) or sslmode=disable (private networks only). require, prefer,
# verify-ca, no-verify and uselibpqcompat beside anything but verify-full are
# refused.
# DATABASE_URL=postgres://app:<password>@db.provider.example:5432/mergebrief?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem
# Or read the DSN from a file (a compose `secrets:` mount). Wins over
# DATABASE_URL with a boot warning; surrounding whitespace is trimmed.
# DATABASE_URL_FILE=/run/secrets/database-url
# false = check-only at boot, for a runtime role without DDL: refuse when
# migrations are pending. Apply them with `docker compose run --rm api migrate`
# (from a checkout, `pnpm -C apps/api migrate`) and a DDL-capable DATABASE_URL.
# MERGEBRIEF_AUTO_MIGRATE=true

# --- Connection pools (api, worker, migrate) ---------------------------------
# The size of each pool, at least 2: the job queue keeps one connection for its
# listener. Keep under the server's max_connections:
#   api replicas x this + worker count x (2 x this + WORKER_LARGE_CONCURRENCY + 2)
# DATABASE_POOL_MAX=10

# =============================================================================
# OPTIONAL
# =============================================================================

# --- GitHub extras (api, worker) ---------------------------------------------
# The App's URL name (github.com/apps/<slug>). Set, Home links a viewer with no
# reachable installation to its install page.
# GITHUB_APP_SLUG=<your-app-slug>
# Reads a pasted private PR the App is not installed on, after the viewer's own
# token is denied. App sign-in tokens are installation-scoped, so they cannot;
# public repos need no PAT. Use a fine-grained PAT with Contents and Pull
# requests read. It serves ONLY the GitHub account that owns it, checked at
# boot, so a bot account's token serves nobody. If GitHub refuses it, it serves
# nobody until you fix it and restart. Diff and file reads on it are limited to
# the commits MergeBrief recorded for that PR; any file path at those commits
# is readable.
# MERGEBRIEF_URL_FALLBACK_TOKEN=<your-fine-grained-pat>

# --- Session key rotation (api) ----------------------------------------------
# The env var NAME new tokens seal under. Point it at a new key var to rotate
# (docs/self-host/operations.md, "Tokens at rest").
# SESSION_KEY_REF=SESSION_KEY_V1

# --- Scaling (compose, worker) -----------------------------------------------
# Concurrent generations = WORKER_COUNT x (WORKER_CONCURRENCY +
# WORKER_LARGE_CONCURRENCY). Prefer one worker and more slots; a second worker
# buys restart isolation. What a slot costs depends on the provider class
# (docs/self-host/generators.md, "Worker slots").
# Slots one worker drains generate jobs into.
# WORKER_CONCURRENCY=1
# Slots of the large pool, which runs the multi-call briefs.
# WORKER_LARGE_CONCURRENCY=1
# Containers compose starts. `docker compose up --scale <service>=N` wins for
# that run. A second api gives failover behind the one web, not an even split,
# and a write can read stale for up to a minute from another replica
# (docs/self-host/operations.md, "Running more than one api").
# WORKER_COUNT=1
# API_COUNT=1

# --- Generation behaviour (worker) -------------------------------------------
# false skips the revision narrative against the previous brief.
# REVISION_NARRATIVE_ENABLED=true
# The share of a PR's changed lines at which an incremental span falls back to
# the full brief. Above 0 and at most 1.
# HUGE_SPAN_RATIO=0.65

# --- Notion context source (worker) ------------------------------------------
# The token for a `notion` entry under contextSources: in mergebrief.config.yaml,
# whose tokenEnv can name another variable. A listed entry with its variable
# unset refuses boot (docs/self-host/trackers.md).
# NOTION_TOKEN=<your-notion-integration-token>

# --- Attachments and media (api) ---------------------------------------------
# What one reviewer may attach per window, counted per api replica. Positive
# whole numbers, and the megabytes at least 10, the size limit of one file.
# MERGEBRIEF_ATTACHMENT_QUOTA_FILES=10
# MERGEBRIEF_ATTACHMENT_QUOTA_MB=30
# MERGEBRIEF_ATTACHMENT_QUOTA_WINDOW_MINUTES=10
# The largest video or image, in megabytes, the api streams, judged on the
# file's full size. A larger one shows "could not load" with an Open on GitHub
# link.
# MERGEBRIEF_MEDIA_MAX_MB=100

# --- Update check (api) ------------------------------------------------------
# About a minute after boot, then at most hourly, the api fetches version.json
# from this project's GitHub Releases. The request identifies nothing. false: no
# banner, no log line, no `latest` in /api/version. A `dev` build never checks.
# MERGEBRIEF_UPDATE_CHECK=true
# A mirror, for a network that blocks github.com.
# MERGEBRIEF_UPDATE_CHECK_URL=https://github.com/Idan91/mergebrief/releases/latest/download/version.json

# --- Retention (worker sweeps; api and migrate validate) ---------------------
# Unset keeps rows forever. Both windows apply across every installation.
# Days before the daily sweep erases audit rows. Minimum 30; set it longer than
# your longest open PR, since audit has to outlive a review session.
# AUDIT_RETENTION_DAYS=365
# Days after a PR closes on GitHub before the sweep erases it, with its briefs
# and every reviewer's session. Minimum 1. The count starts at the close, not
# the brief: a pasted PR closed before the window is erased by the next sweep.
# PR_RETENTION_DAYS=90

# --- Audit and display names (api writes; worker and migrate validate) -------
# EMPTY READS AS false for both. false stops the api recording writes that stay
# inside the instance; writes reaching GitHub and every denial are recorded
# either way.
# AUDIT_PRIVATE_WRITES=true
# Validated, but nothing reads it yet, so it changes nothing.
# STORE_DISPLAY_NAMES=true

# --- Logging (api, worker, migrate) ------------------------------------------
# error, warn, info or debug, lowercase. `web` reads no `.env`: set it under
# that service's environment: in docker-compose.override.yml.
# LOG_LEVEL=info

# --- Tracing (api, worker, web) ----------------------------------------------
# Off until an endpoint is set, then OTLP/HTTP protobuf
# (docs/self-host/observability.md). `web` gets every variable below except the
# headers. The other OTEL_* variables reach api and worker only
# (docs/self-host/configuration.md). Leave OTEL_SERVICE_NAME unset: the
# processes name themselves.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# The full traces URL; wins over the base endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=<key>=<value>
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# Default parentbased_always_on keeps every trace.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# true, in any case, turns tracing off even with an endpoint set.
# OTEL_SDK_DISABLED=true

# --- API listener (api, web; compose sets these) -----------------------------
# Host processes only: compose overrides all three so the containers reach each
# other, and publishes no API port.
# MERGEBRIEF_API_HOST=127.0.0.1
# MERGEBRIEF_API_PORT=3001
# MERGEBRIEF_API_ORIGIN=http://127.0.0.1:3001
