# Self-host configuration — copy to `.env` (gitignored) and fill in.
# docker-compose reads this file for BOTH services; leave a var out entirely
# (rather than setting it empty) when it does not apply — several loaders
# distinguish unset from empty (e.g. the App private-key one-of below).

# --- GitHub App (web webhook/auth tier AND worker PR fetches) ---------------
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two. For compose, the inline PEM is simplest
# (multi-line values work in compose env_file when quoted; or mount a file
# and use the _PATH variant).
GITHUB_APP_PRIVATE_KEY=<pem-contents>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=<webhook-secret>
GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>

# --- Reviewer sessions (web) -------------------------------------------------
# 32-byte base64 key sealing reviewer OAuth tokens (ADR 0018 D11), e.g.:
#   openssl rand -base64 32
SESSION_KEY_V1=<base64-32-bytes>

# --- Public origin (web + worker) ---------------------------------------------
# Must match the GitHub App's registered OAuth callback origin. The worker
# also requires it: the Entry comment's deep link is built from this origin.
PUBLIC_BASE_URL=http://localhost:3000

# --- Generation provider key (worker + web; BYOK by env-name, ADR 0013) -----
# The zero-config default reads ANTHROPIC_API_KEY. A different provider or
# key variable is selected in mergebrief.config.yaml (copy
# mergebrief.config.example.yaml; see docs/self-host/generators.md); point
# MERGEBRIEF_CONFIG at that file. GENERATOR_API_KEY_ENV was removed in
# BRIEF-11 — setting it refuses boot with a migration hint.
ANTHROPIC_API_KEY=<your-anthropic-key>
# Other providers' key vars (only the one your config names is required):
# OPENROUTER_API_KEY=<your-openrouter-key>
# OPENAI_API_KEY=<your-openai-key>

# Relative = resolved against the workspace root (BRIEF-70) — the same
# value works locally and in the dockerized services. Absolute paths work
# too. For live edits without an image rebuild, also uncomment the
# mergebrief.config.yaml mount in docker-compose.yml.
# MERGEBRIEF_CONFIG=mergebrief.config.yaml
