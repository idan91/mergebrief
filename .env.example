# Self-host configuration — copy to `.env` (gitignored) and fill in.
# docker-compose reads this file for `api` and `worker` (the `web` service gets
# no env_file: it holds no credentials); leave a var out entirely
# (rather than setting it empty) when it does not apply — several loaders
# distinguish unset from empty (e.g. the App private-key one-of below).

# --- Postgres (the single stateful dependency) -------------------------------
# Compose interpolates these into the postgres service AND derives both
# services' in-network DATABASE_URL from them. Defaults (code_review /
# code_review / code_review) keep `docker compose up` working out of the box
# — CHANGE THE PASSWORD BEFORE THE FIRST BOOT of anything reachable beyond
# your machine. Postgres writes the role during first-time initialization
# ONLY: after that, changing this value needs an `ALTER ROLE ... PASSWORD`
# inside the container (or deleting the `postgres_data` volume, which
# destroys your data). The value is interpolated RAW into a connection
# string, so keep it to characters that need no escaping — hex is always
# safe. Do NOT percent-encode: postgres stores the role password exactly as
# given here, while the connection string is DECODED on the way in, so an
# encoded password authenticates as something else and the first boot fails.
#   openssl rand -hex 24
# POSTGRES_USER=code_review
# POSTGRES_PASSWORD=<generate-one>
# POSTGRES_DB=code_review

# --- External Postgres (skip with the bundled compose postgres) --------------
# Point both services at a managed/external database instead of the compose
# one (docker-compose.external-db.yml — see docs/self-host/compose.md). A
# NON-LOOPBACK host requires an explicit sslmode in the DSN or boot is
# refused: verify-full + sslrootcert (recommended), require, or disable
# (private networks only). Note pg's trap: today `require` verifies like
# verify-full, but pg v9 adopts libpq semantics where it does NOT — write
# what you mean.
# DATABASE_URL=postgres://app:<password>@db.provider.example:5432/mergebrief?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem
# Or read the DSN from a file (compose `secrets:` mount) — wins over
# DATABASE_URL with a boot warning; surrounding whitespace is trimmed:
# DATABASE_URL_FILE=/run/secrets/database-url
# Restricted runtime role without DDL? false = check-only at boot: refuse
# when migrations are pending instead of applying them. The apply step is
# then `docker compose run --rm api migrate` (from a checkout:
# `pnpm -C apps/api migrate`) with a DDL-capable DATABASE_URL.
# MERGEBRIEF_AUTO_MIGRATE=true
# The size of each Postgres pool. An api process opens one pool, a worker
# two (its store and its job queue), so api replicas plus twice the worker
# count, times this value, must stay under the server's max_connections.
# At least 2: the job queue keeps one connection for its listener.
# DATABASE_POOL_MAX=10

# --- GitHub App (api webhook/auth tier AND worker PR fetches) ---------------
GITHUB_APP_ID=<your-app-id>
# Exactly ONE of the next two. For compose, the inline PEM is simplest
# (multi-line values work in compose env_file when quoted; or mount a file
# and use the _PATH variant).
GITHUB_APP_PRIVATE_KEY=<pem-contents>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=<webhook-secret>
# OAuth client: the api's sign-in, and the worker revoking a swept grant's
# token at GitHub.
GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>
# Optional: the App's URL name (github.com/apps/<slug>). Set, Home links a
# viewer with no reachable installation to its install page.
# GITHUB_APP_SLUG=<your-app-slug>

# --- Reviewer sessions (api + worker) -------------------------------------
# The worker opens grants with it for pasted PRs and the hourly sweep.
# 32-byte base64 key sealing reviewer OAuth tokens (ADR 0018 D11), e.g.:
#   openssl rand -base64 32
SESSION_KEY_V1=<base64-32-bytes>
# Optional: the env var NAME new tokens seal under. Point it at a new key var
# to rotate (docs/self-host/operations.md, "Tokens at rest").
# SESSION_KEY_REF=SESSION_KEY_V1

# --- Public origin (api + web + worker) ------------------------------------
# Must match the GitHub App's registered OAuth callback origin. The worker
# also requires it: the Entry comment's deep link is built from this origin.
# The API refuses a signed-in browser's state-changing request from any
# other origin, so this is the origin reviewers browse, scheme and port
# included.
PUBLIC_BASE_URL=http://localhost:3000

# --- The API process -------------------------------------------------------
# Where the API listens, and where the web tier proxies `/api/*`. The
# defaults are loopback: compose overrides both so the two containers can
# reach each other, and nothing publishes the API port to the host.
# MERGEBRIEF_API_HOST=127.0.0.1
# MERGEBRIEF_API_PORT=3001
# MERGEBRIEF_API_ORIGIN=http://127.0.0.1:3001

# --- The update check (api) ------------------------------------------------
# About a minute after boot and then at most once an hour, the API fetches one
# static file, version.json, from this project's GitHub Releases to learn
# about newer releases. The request identifies nothing: no id, no version, no
# counts, a default User-Agent. Off: no banner, no log line, no `latest` in
# /api/version. A `dev` build never checks.
# MERGEBRIEF_UPDATE_CHECK=true
# Where version.json is fetched from; point it at a mirror on a network that
# blocks github.com. Default: this project's latest GitHub Release asset.
# MERGEBRIEF_UPDATE_CHECK_URL=https://github.com/Idan91/code-review/releases/latest/download/version.json

# --- Attachment upload quota (api) -----------------------------------------
# What one reviewer may attach per window. Counted in memory per api replica,
# so N replicas allow up to N times these. Positive whole numbers; anything
# else refuses boot.
# MERGEBRIEF_ATTACHMENT_QUOTA_FILES=10
# MERGEBRIEF_ATTACHMENT_QUOTA_MB=30
# MERGEBRIEF_ATTACHMENT_QUOTA_WINDOW_MINUTES=10

# Feature flags. Everything matching ENABLE_* is inlined into the client
# bundle, so only boolean toggles belong under this prefix, never a secret.
# Language selection is off by default: the catalog and locale machinery stay
# wired, the picker is simply not rendered.
ENABLE_LANGUAGE_SELECTION=false

# --- Generation provider key (worker; BYOK by env-name, ADR 0013) ----------
# The zero-config default reads ANTHROPIC_API_KEY. A different provider or
# key variable is selected in mergebrief.config.yaml (copy
# mergebrief.config.example.yaml; see docs/self-host/generators.md); point
# MERGEBRIEF_CONFIG at that file. GENERATOR_API_KEY_ENV was removed in
# BRIEF-11 — setting it refuses boot with a migration hint.
ANTHROPIC_API_KEY=<your-anthropic-key>
# Other providers' key vars (only the one your config names is required):
# OPENROUTER_API_KEY=<your-openrouter-key>
# OPENAI_API_KEY=<your-openai-key>
# cursor only, OPTIONAL — the interactive `cursor-agent login` is the normal
# route; this env key outranks it and bills the same subscription pool.
# On macOS the CLI persists it to the keychain.
# CURSOR_API_KEY=<your-cursor-key>

# --- URL-box fallback token (api + worker; optional) -----------------------
# GitHub App sign-in tokens are INSTALLATION-SCOPED: the "Turn a PR into a
# brief" box cannot read a private repo the App is not installed on, even for
# the repo's owner. Public repos need no PAT — a sign-in token reads those.
# A PAT here (fine-grained, Contents+Pull requests read on the repos you
# want) backstops exactly that private case — tried only after the viewer's
# token is denied, by the paste door, the worker, the Inbox's live read AND
# the read gate that opens the resulting brief.
# The token serves ONLY the GitHub account that owns it: at boot api and
# worker ask GitHub whose token it is, and only that account can generate
# and read briefs through it. Everyone else gets the instance as if no token
# were set. Make the PAT on your own account; one made on a bot or machine
# account serves no person. If GitHub refuses the token, it serves nobody
# until you fix it and restart. On the token, diff and file reads are
# limited to the commits MergeBrief recorded for that pull request; the file
# path is not limited, so any file at one of those commits is readable.
# MERGEBRIEF_URL_BOX_TOKEN=<your-fine-grained-pat>

# Relative = resolved against the workspace root, so the same value works
# locally and in the dockerized services. Absolute paths work too. The
# image carries no config file: when this names one, also uncomment the
# mergebrief.config.yaml mount in docker-compose.yml (api and worker), or
# the services refuse to boot on a missing file.
# MERGEBRIEF_CONFIG=mergebrief.config.yaml

# --- Worker capacity (worker; optional) --------------------------------------
# Concurrent generations = WORKER_COUNT x WORKER_CONCURRENCY. Prefer one
# worker and more slots; a second worker buys restart isolation, not
# throughput slots could not give you. What a slot costs depends on the
# provider class; see docs/self-host/generators.md, "Worker slots".
# Slots one worker process drains generate jobs into. Default 1.
# WORKER_CONCURRENCY=1
# Worker containers compose starts. Default 1. `docker compose up --scale
# worker=N` wins over this for that run.
# WORKER_COUNT=1

# --- API capacity (compose; optional) -----------------------------------------
# API containers compose starts. Default 1. Every replica serves every
# request; a second one gives failover behind the one web, an even split
# needs a load balancer, and a write can read stale for up to a minute from
# another replica (operations.md, "Running more than one api"). `docker
# compose up --scale api=N` wins over this for that run.
# API_COUNT=1

# --- Audit retention (worker; optional) -------------------------------------
# Unset keeps audit rows forever, which is the default posture. Set a number
# of days and the worker's daily sweep erases anything older, across every
# installation. Minimum 30 — and set it longer than your longest open PR:
# audit has to outlive a review session. See docs/self-host/operations.md.
# AUDIT_RETENTION_DAYS=365

# --- Pull request retention (worker; optional) ------------------------------
# Unset keeps every closed or merged pull request's briefs forever, which is
# the default posture. Set a number of days (minimum 1) and the worker's
# daily sweep erases every pull request closed longer ago than that, its
# briefs and every reviewer's session with it, across every installation and
# every pasted PR. The window counts from the close on GitHub, not from the
# brief: a pasted PR that closed before the window is briefed, then erased by
# the next sweep. See docs/self-host/operations.md.
# PR_RETENTION_DAYS=90

# --- Tracing (api + worker + web; optional) ---------------------------------
# Off unless an OTLP/HTTP endpoint is set: then every process sends traces to
# it, protobuf over HTTP. Point it at a local OpenTelemetry Collector or the
# Datadog Agent's OTLP receiver; see docs/self-host/observability.md. The
# web service gets every variable below except the headers. Leave
# OTEL_SERVICE_NAME unset: the processes name themselves mergebrief-api,
# mergebrief-worker and mergebrief-web.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=<key>=<value>
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# Default parentbased_always_on: every trace is kept.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
