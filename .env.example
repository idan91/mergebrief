# MergeBrief settings. Copy to `.env` beside docker-compose.yml and fill in.
# `.env` is gitignored: never commit real values. Compose, `pnpm app:host` and
# the api under `pnpm dev` all read this one file. The web tier under
# `pnpm dev` does not: it takes its few variables from the shell.
#
# An uncommented line is required. A commented line is optional and shows the
# default, or an example where the variable has none.
# Leave out a variable that does not apply. Do not set it empty: some read
# empty differently from unset, and a bad value refuses boot.
#
# Every variable, which process reads it and what it accepts:
# docs/self-host/configuration.md

# =============================================================================
# REQUIRED
# =============================================================================

# --- GitHub App (docs/self-host/github-app.md) -------------------------------
GITHUB_APP_ID=<your-app-id>
# Set exactly one of the next two. Quote a multi-line inline value.
GITHUB_APP_PRIVATE_KEY=<pem-contents>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# At least 32 characters: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=<webhook-secret>
GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>

# --- Session key -------------------------------------------------------------
# Seals reviewer tokens at rest. Base64 of 32 bytes: openssl rand -base64 32
SESSION_KEY_V1=<base64-32-bytes>

# --- Public origin -----------------------------------------------------------
# The origin reviewers browse, scheme and port included. It must match the
# GitHub App's OAuth callback origin.
PUBLIC_BASE_URL=http://localhost:3000

# --- Model provider key ------------------------------------------------------
# The default provider reads this one. mergebrief.config.yaml can choose
# another provider, and then only the key it names is required.
ANTHROPIC_API_KEY=<your-anthropic-key>
# OPENAI_API_KEY=<your-openai-key>
# OPENROUTER_API_KEY=<your-openrouter-key>
# Host processes only (`pnpm app:host`): the image refuses the cursor provider.
# CURSOR_API_KEY=<your-cursor-key>

# =============================================================================
# NEEDED BEFORE ANYONE CAN SIGN IN
# =============================================================================

# --- Instance config ---------------------------------------------------------
# Nobody signs in until this file lists them under `operators`. Copy
# mergebrief.config.example.yaml, then mount it into api and worker
# (docs/self-host/compose.md).
# MERGEBRIEF_CONFIG=mergebrief.config.yaml

# =============================================================================
# DATABASE (bundled Postgres is the default; fill in one block)
# =============================================================================

# --- Bundled Postgres (docs/self-host/compose.md) ----------------------------
# SET THE PASSWORD BEFORE THE FIRST BOOT of anything reachable beyond your
# machine: Postgres stores it on first init only. Use `openssl rand -hex 24`
# as it is, since URL characters in a password break the connection string.
# POSTGRES_USER=code_review
# POSTGRES_PASSWORD=<generate-one>
# POSTGRES_DB=code_review

# --- External Postgres (docs/self-host/compose.md) ---------------------------
# Selects the compose file without the bundled postgres.
# COMPOSE_FILE=docker-compose.external-db.yml
# A host beyond loopback needs sslmode=verify-full or sslmode=disable.
# DATABASE_URL=postgres://app:<password>@db.provider.example:5432/mergebrief?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem
# Reads the DSN from a file. Wins over DATABASE_URL.
# DATABASE_URL_FILE=/run/secrets/database-url
# false checks migrations at boot and applies none. EMPTY READS AS false.
# MERGEBRIEF_AUTO_MIGRATE=true

# --- Host processes (`pnpm app:host`) ----------------------------------------
# Required on the host. The default compose file sets its own for containers.
# DATABASE_URL=postgres://code_review:code_review@127.0.0.1:5432/code_review

# --- Connection pool (docs/self-host/operations.md) --------------------------
# Connections each pool opens at most, at least 2.
# DATABASE_POOL_MAX=10

# =============================================================================
# OPTIONAL
# =============================================================================

# --- GitHub extras -----------------------------------------------------------
# The App's URL name (github.com/apps/<slug>), for the install link on Home.
# GITHUB_APP_SLUG=<your-app-slug>
# Reads a pasted private PR the App is not installed on. It serves only the
# GitHub account that owns it, so a bot account's token serves nobody.
# docs/self-host/compose.md#hardening-before-real-exposure
# MERGEBRIEF_URL_FALLBACK_TOKEN=<your-fine-grained-pat>

# --- Session key rotation (docs/self-host/operations.md, "Tokens at rest") ---
# The NAME of the variable new tokens seal under.
# SESSION_KEY_REF=SESSION_KEY_V1

# --- Scaling (docs/self-host/generators.md#worker-slots) ---------------------
# Generate jobs one worker runs at once.
# WORKER_CONCURRENCY=1
# Slots of the large pool, which runs the multi-call briefs.
# WORKER_LARGE_CONCURRENCY=1
# Containers compose starts.
# WORKER_COUNT=1
# API_COUNT=1

# --- Generation behaviour ----------------------------------------------------
# false skips the revision narrative against the previous brief.
# REVISION_NARRATIVE_ENABLED=true
# The share of a PR's changed lines, above 0 and at most 1, at which an
# incremental span falls back to the full brief.
# HUGE_SPAN_RATIO=0.65

# --- Tracker credentials (docs/self-host/trackers.md) ------------------------
# Needed only for a `notion` or `jira` entry under contextSources in
# mergebrief.config.yaml. An entry whose variable is unset refuses boot.
# NOTION_TOKEN=<your-notion-integration-token>
# JIRA_EMAIL=<the-token-owner-account-email>
# JIRA_API_TOKEN=<your-jira-api-token>

# --- Attachments and media (docs/self-host/attachments.md) -------------------
# What one reviewer may attach per window. The megabytes are at least 10.
# MERGEBRIEF_ATTACHMENT_QUOTA_FILES=10
# MERGEBRIEF_ATTACHMENT_QUOTA_MB=30
# MERGEBRIEF_ATTACHMENT_QUOTA_WINDOW_MINUTES=10
# The largest video or image, in megabytes, the api streams.
# MERGEBRIEF_MEDIA_MAX_MB=100

# --- Update check (docs/self-host/operations.md#the-update-check) ------------
# false stops the hourly fetch of version.json and the version notice.
# MERGEBRIEF_UPDATE_CHECK=true
# A mirror, for a network that blocks github.com.
# MERGEBRIEF_UPDATE_CHECK_URL=https://github.com/Idan91/mergebrief/releases/latest/download/version.json

# --- Retention (docs/self-host/operations.md) --------------------------------
# Unset keeps rows forever.
# Days the daily sweep keeps audit rows, at least 30.
# AUDIT_RETENTION_DAYS=365
# Days a pull request is kept after it closes on GitHub, at least 1.
# PR_RETENTION_DAYS=90

# --- Audit -------------------------------------------------------------------
# false stops recording writes that stay inside the instance.
# EMPTY READS AS false.
# AUDIT_PRIVATE_WRITES=true

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug
# LOG_LEVEL=info

# --- Tracing (docs/self-host/observability.md) -------------------------------
# Off until an endpoint is set. Leave OTEL_SERVICE_NAME unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# The full traces URL. Wins over the base endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=<key>=<value>
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# The default sampler keeps every trace.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# true turns tracing off even with an endpoint set.
# OTEL_SDK_DISABLED=true

# --- API listener (host processes only; compose sets all three) --------------
# MERGEBRIEF_API_HOST=127.0.0.1
# MERGEBRIEF_API_PORT=3001
# MERGEBRIEF_API_ORIGIN=http://127.0.0.1:3001
