{
  "name": "release",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The release tool: reads the per-release notes files, refuses a tag without one, stamps the tag's version into the shipped manifests, and writes the Release body and version.json the workflow uploads.",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "tsx src/main.ts check",
    "stamp": "tsx src/main.ts stamp",
    "prune-manifest": "tsx src/main.ts prune-manifest",
    "version-json": "tsx src/main.ts version-json",
    "release-body": "tsx src/main.ts release-body",
    "licenses": "tsx src/main.ts licenses",
    "notices": "tsx src/main.ts notices"
  },
  "dependencies": {
    "types": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
