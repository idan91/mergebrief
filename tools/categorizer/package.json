{
  "name": "categorizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev CLIs + the BRIEF-59 generation-quality eval harness on top of brief-core (the Brief domain core lives there since BRIEF-68).",
  "scripts": {
    "categorize": "tsx ../../packages/brief-core/src/cli/categorize.ts",
    "delta": "tsx ../../packages/brief-core/src/cli/delta.ts",
    "eval": "tsx eval/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:enum": "tsx scripts/probe-enum-enforcement.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "brief-core": "workspace:*",
    "generators": "workspace:*",
    "types": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
