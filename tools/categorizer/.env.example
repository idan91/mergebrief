# Anthropic API key — get one from https://console.anthropic.com
# Copy this file to .env and fill in the value.
ANTHROPIC_API_KEY=sk-ant-...

# Jira account email and API token — only for a PR whose ticket lives in Jira,
# with a `jira` entry under contextSources: in the file --config names. Create
# an API token with scopes (read:jira-work only) at https://id.atlassian.com
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=<your-jira-api-token>
