{
  "name": "pr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PR stack tooling for agents and maintainers: one status line set per stacked PR, and thread replies that the status remembers as answered.",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "stack-status": "tsx src/main.ts stack-status",
    "reply": "tsx src/main.ts reply"
  },
  "dependencies": {
    "types": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
