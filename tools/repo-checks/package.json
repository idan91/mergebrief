{
  "name": "repo-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A tree-wide check inside pnpm lint that every server config key is in .env.example, plus the tests for the repo-local git hooks.",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:env": "tsx src/main.ts env"
  },
  "dependencies": {
    "types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
