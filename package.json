{
  "name": "code-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "typecheck": "pnpm -C apps/web typecheck",
    "test": "pnpm -C tools/categorizer test",
    "typecheck:persistence": "pnpm -C packages/persistence typecheck",
    "test:persistence": "pnpm -C packages/persistence test",
    "typecheck:worker": "pnpm -C packages/worker typecheck",
    "test:worker": "pnpm -C packages/worker test",
    "lint": "oxlint --type-aware && eslint . --quiet && knip --no-config-hints && pnpm -C apps/web lint"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "knip": "^6.31.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0"
  }
}
