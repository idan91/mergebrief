{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead exports, unused deps and unreachable files across the pnpm workspace
  // (ADR 0038 §7) — the mechanical half of the BRIEF-90 entry-barrel policy.
  // Entry points are stated per workspace even where knip infers them from
  // `exports`/`bin`, because the entry IS the policy here: `src/index.ts` is a
  // package's curated public surface, and anything not reachable from one of
  // these files is dead by definition.
  "ignoreExportsUsedInFile": true,
  // `@public` marks an export that is part of a module's published surface
  // even when nothing imports it yet — the paired `ValueOf` type of an
  // `as const` map, whose discriminated unions need the member types rather
  // than the union.
  "tags": ["-@public"],
  "workspaces": {
    ".": {
      // The shared coverage policy is imported by every package's vitest
      // config, which knip resolves per workspace, not from the root.
      "entry": ["vitest.shared.ts"],
      // Loaded by oxlint through `.oxlintrc.json`'s `jsPlugins`, by name;
      // there is no import for knip to see.
      "ignoreDependencies": ["eslint-plugin-i18next"],
      "project": ["*.ts", "*.js"],
      // The CI/weekly workflows install browsers with `pnpm -C apps/web exec
      // playwright ...`. knip attributes a workflow's binaries to the root
      // workspace, which does not (and should not) depend on Playwright —
      // apps/web owns it. `manifest` is likewise not a binary: the dev/build
      // scripts invoke `pnpm -C apps/api manifest`, a package script.
      "ignoreBinaries": ["playwright", "manifest"],
    },
    "apps/web": {
      // Routes are the app's entry surface; the feature `index.tsx` barrels
      // are the curated internal one (ADR 0037) — a barrel export is the
      // published surface, not a call site, so it is an entry, not dead code.
      "entry": [
        "src/router.tsx",
        "src/server.ts",
        "src/routes/**/*.tsx",
        "src/features/*/index.tsx",
        "src/features/*/utils/index.ts",
        // The browser suite (BRIEF-113) is run by Playwright, not imported:
        // its config and specs are entries, and `e2e/support` + `e2e/fixtures`
        // hang off them.
        "playwright.config.ts",
        "playwright.perf.config.ts",
        "e2e/**/*.e2e.ts",
        "e2e/**/*.perf.ts",
        // The harness seed runs as a tsx child process; the generator is a
        // pnpm script.
        "e2e/harness/seed.ts",
        "e2e/perf/generateFixture.ts",
      ],
    },
    "apps/api": {
      "entry": ["src/index.ts", "scripts/generate-manifest.ts"],
    },
    "packages/brief-core": {
      "entry": ["src/index.ts", "src/types.ts", "src/cli/*.ts"],
    },
    "apps/cli": {
      "entry": [
        "src/bin.ts",
        "scripts/embed-help.ts",
        "scripts/check-operations-map.ts",
      ],
    },
    "packages/generators": {
      // The `.cjs` shims are spawned as real child processes by the contract
      // suites (path reference, never imported).
      "entry": ["src/index.ts", "smoke/generate-smoke.ts", "test/shims/*.cjs"],
    },
    "packages/github": { "entry": ["src/index.ts"] },
    "packages/i18n": { "entry": ["src/index.ts"] },
    "packages/logging": {
      "entry": ["src/index.ts"],
      // pino-pretty is loaded by pino BY NAME (`transport.target`) in
      // development only — there is no import for knip to see.
      "ignoreDependencies": ["pino-pretty"],
    },
    "packages/persistence": {
      "entry": ["src/index.ts", "src/testing.ts", "drizzle.config.ts"],
      // knip's drizzle plugin EXECUTES drizzle.config.ts, which refuses to
      // load without DATABASE_URL — the config is listed as a plain entry
      // instead, which is all the plugin would have contributed here.
      "drizzle": false,
    },
    "packages/repo-config": { "entry": ["src/index.ts"] },
    "packages/types": { "entry": ["src/index.ts"] },
    "apps/worker": { "entry": ["src/index.ts", "src/main.ts"] },
    "tools/ingest-briefs": { "entry": ["src/index.ts", "src/main.ts"] },
    "tools/oxlint-plugin-house": {
      "entry": ["src/index.mjs"],
      // Each rule's counter-examples: linted by the plugin's tests, never
      // imported.
      "ignore": ["test/fixtures/**"],
    },
    "tools/categorizer": {
      // Each eval case's `expected.ts` is dynamically imported by absolute
      // path from the case loader (BRIEF-59), so it is an entry too.
      "entry": [
        "eval/cli.ts",
        "scripts/*.ts",
        "eval/cases/*/expected.ts",
        "eval/pair-cases/*/expected.ts",
        "test/fixtures/*/expected.ts",
      ],
    },
  },
  "ignore": ["**/routeTree.gen.ts", "**/*.gen.*", "mockup/**"],
}
