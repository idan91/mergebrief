{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react-perf is deliberately absent: its inline-prop rules contradict the
  // house style (no memoization by default — inline handlers to non-memoized
  // children are idiomatic and free).
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    // Vite uses the automatic JSX runtime — no React import needed for JSX.
    "react/react-in-jsx-scope": "off",
    // div[role=status] is the standard WAI-ARIA live-region idiom; <output>
    // is form-associated (label/value semantics) and not a drop-in.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Labelled region + tabindex=0 is the required pattern for keyboard-
    // reachable scroll containers (axe: scrollable-region-focusable).
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["region"] }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    // The root standard's "no bare `as`" rule (BRIEF-44). `as const` and
    // `satisfies` are unaffected; boundaries narrow with Zod or a type guard,
    // and a genuinely-unavoidable cast takes a line-scoped disable + reason.
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    // The closest oxlint gets to the root standard's `enum` ban: it covers
    // `const enum` only. Plain `enum` is NOT expressible here — oxlint has no
    // `no-enum` and no `no-restricted-syntax` (checked, oxlint 1.72), so that
    // half of the rule stays prose (ADR 0037 #8).
    "oxc/no-const-enum": "error",
    // Named exports only; the four framework-required default exports are
    // carved out per-path in the overrides.
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    // Side-effect imports are how Vite loads global styles and server
    // entrypoints register themselves.
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss", "@tanstack/react-start/server-only"]
      }
    ],
    "no-console": ["error", { "allow": ["warn", "error", "info"] }],
    // `__typename` is GraphQL's own introspection field — the only way to
    // discriminate author kinds (User vs Bot) on the wire.
    "no-underscore-dangle": ["error", { "allow": ["__typename"] }],
    // Effects legitimately mix early `return;` with `return cleanup` — the
    // conditional-cleanup idiom React documents; tsc checks the return type.
    "typescript/consistent-return": "off",
    // Spread-in-map is the codebase's deliberate immutable-update idiom;
    // the rule's suggested in-place mutation would alias parsed objects.
    "oxc/no-map-spread": "off",
    // The only index-keyed lists (diff lines, markdown segments) are
    // immutable and never reorder within a render lifetime, and have no
    // natural ids — index keys are stable there by construction.
    "react/no-array-index-key": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/.playwright-cli/**",
    "**/routeTree.gen.ts"
  ],
  "overrides": [
    {
      // ADR 0034's logging-seam scope, stated as paths: every line in these
      // files goes through `packages/logging`, so NO console level survives
      // (the global rule's warn/error/info allowance is client-side only).
      "files": [
        "packages/api/src/**",
        "packages/worker/src/**",
        "apps/web/src/server.ts",
        "apps/web/src/server/**",
        "apps/web/src/**/*.server.ts"
      ],
      "rules": {
        "no-console": "error"
      }
    },
    {
      // Framework-required default exports: vite/tsup/drizzle read the
      // default export of their config, ESLint's flat config is the default
      // export of `eslint.config.js`, and TanStack Start's server entry is
      // resolved the same way.
      "files": ["**/*.config.ts", "eslint.config.js", "apps/web/src/server.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        // Sequential awaits in tests are usually the point (step-by-step UI
        // flows where each action depends on the previous one settling).
        "no-await-in-loop": "off",
        // expect(mock.method).toHaveBeenCalled — the standard vitest pattern
        // the rule can't distinguish from a real unbound `this` hazard.
        "typescript/unbound-method": "off",
        // Narrowing getByRole/getElementById results is routine in tests;
        // tsgolint's preview verdicts on these are inconsistent (identical
        // casts flagged unsafe at one site, unnecessary at another).
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        // Same reason the two rules above are off here: narrowing a fixture
        // or a DOM query to the shape under test is the test's own setup,
        // not an escape from a boundary contract.
        "typescript/consistent-type-assertions": "off",
        // Mocks here pass implementations (vi.fn(async () => fixture)), which
        // already fully type them — explicit type parameters would be
        // redundant annotations, not added safety.
        "vitest/require-mock-type-parameters": "off",
        // Custom assertion helpers that wrap expect() internally (e.g.
        // expectCheckViolation walking a driver error's cause chain).
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "expect*"] }
        ]
      }
    },
    {
      // The categorize/delta CLI entries (+ their output writer) live in
      // brief-core since BRIEF-68 — same files, same carve-out as before the
      // move: stdout printing is their interface.
      "files": ["packages/brief-core/src/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
